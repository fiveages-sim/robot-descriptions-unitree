            (2,0)  -1.5
            (3,0)  -1.5
            (4,0)  -3.14
            (5,0)  -3.14
            (6,0)  -3.14
            (7,0)  -3.14
            (8,0)  -3.14
            (9,0)  -3.14
            (10,0) -3.14
            (11,0) -3.14
            (12,0) -3.14
            (13,0) -3.14
            (14,0) -3.14
            (15,0) -3.14
            (16,0) -3.14
            (17,0) -3.14
        }
    }

    upperBound
    {
        arm
        {
            (0,0)  0.2
            (1,0)  1.5
            (2,0)  1.5
            (3,0)  1.5
            (4,0)  3.14
            (5,0)  3.14
            (6,0)  3.14
            (7,0)  3.14
            (8,0)  3.14
            (9,0)  3.14
            (10,0) 3.14
