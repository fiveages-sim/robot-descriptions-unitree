selfCollision
{
    activate                        false
    mu                              1e-3
    delta                           1e-2
    minimumDistance                 0.01
    collisionObjectPairs
    {
    }
    collisionLinkPairs
    {
        [0] "waist_pitch_link, left_shoulder_yaw_link",
        [1] "waist_pitch_link, left_elbow_link",
        [2] "waist_pitch_link, left_wrist_roll_link",
        [3] "waist_pitch_link, left_wrist_pitch_link",
        [4] "waist_pitch_link, right_shoulder_yaw_link",
        [5] "waist_pitch_link, right_elbow_link",
        [6] "waist_pitch_link, right_wrist_roll_link",
        [7] "waist_pitch_link, right_wrist_pitch_link",
    }
}
