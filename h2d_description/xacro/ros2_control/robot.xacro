<?xml version="1.0"?>
<robot name="h2d" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="gazebo" default="false"/>

	<xacro:include filename="$(find h2d_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find unitree_g1_description)/xacro/ros2_control/arm_ros2_control.xacro"/>
	<xacro:include filename="$(find unitree_dex_description)/xacro/ros2_control/dex1.xacro"/>
	<xacro:include filename="$(find unitree_dex_description)/xacro/ros2_control/dex3.xacro"/>

	<ros2_control name="h2d_system" type="system">
		<hardware>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
				<plugin>gz_ros2_control/GazeboSimSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
				<plugin>mock_components/GenericSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
				<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
				<param name="joint_commands_topic">/isaac/joint_command</param>
				<param name="joint_states_topic">/isaac/joint_states</param>
			</xacro:if>
		</hardware>

		<!-- Body: waist heave + pitch -->
		<joint name="waist_heave_joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="waist_pitch_joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<!-- Head -->
		<joint name="head_pitch_joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="head_yaw_joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<!-- Arms (unitree_g1_description). Dex1 / Dex3 (unitree_dex_description). -->
		<xacro:UnitreeG1ArmInterfaces name="left"/>
		<xacro:UnitreeG1ArmInterfaces name="right"/>
		<xacro:if value="${'$(arg type)' == 'dex1'}">
			<xacro:UnitreeDex1Interfaces name="left" eef_fixed="$(arg eef_fixed_joints)"/>
			<xacro:UnitreeDex1Interfaces name="right" eef_fixed="$(arg eef_fixed_joints)"/>
		</xacro:if>
		<xacro:if value="${'$(arg type)' == 'dex3'}">
			<xacro:UnitreeDex3Interfaces name="left" eef_fixed="$(arg eef_fixed_joints)"/>
			<xacro:UnitreeDex3Interfaces name="right" eef_fixed="$(arg eef_fixed_joints)"/>
		</xacro:if>

		<!-- Drive wheels (not in ocs2_* / body / head controllers) -->
		<joint name="left_wheel_roll_joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="right_wheel_roll_joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
	</ros2_control>

	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find h2d_description)/config/ros2_control/ros2_controllers.yaml</parameters>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
