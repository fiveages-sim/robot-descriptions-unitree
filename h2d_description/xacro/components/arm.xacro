<?xml version="1.0"?>
<!-- H2D 7-DoF arm. Both sides keep the CAD numbers; they are not a pure mirror. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:macro name="UnitreeH2DArm" params="name">
		<xacro:if value="${name == 'left'}">
		<link name="left_shoulder_pitch_link">
			<inertial>
				<origin xyz="-0.0027817 0.050393 -0.023914" rpy="0 0 0"/>
				<mass value="1.1927"/>
				<inertia ixx="0.0017479" ixy="2.142E-05" ixz="-1.982E-05" iyy="0.0014061" iyz="0.0003514" izz="0.0010767"/>
			</inertial>
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<mesh filename="file://$(find h2d_description)/meshes/left_shoulder_pitch_link.stl"/>
				</geometry>
				<material name="left_shoulder_pitch_link_color">
					<color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
				</material>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<mesh filename="file://$(find h2d_description)/meshes/left_shoulder_pitch_link.stl"/>
				</geometry>
			</collision>
		</link>
		<joint name="left_shoulder_pitch_joint" type="revolute">
			<origin xyz="0.0021575 0.041945 0.389" rpy="0.26914 0 0"/>
			<parent link="waist_pitch_link"/>
			<child link="left_shoulder_pitch_link"/>
			<axis xyz="0 1 0"/>
			<limit lower="-2.618" upper="1.833" effort="130" velocity="21.9"/>
		</joint>
		<link name="left_shoulder_roll_link">
			<inertial>
				<origin xyz="-0.00126759 0.00399799 -0.06652669" rpy="0 0 0"/>
				<mass value="1.10982649"/>
				<inertia ixx="0.00176503" ixy="6.24E-06" ixz="-7.05E-06" iyy="0.00193755" iyz="2.293E-05" izz="0.00106446"/>
