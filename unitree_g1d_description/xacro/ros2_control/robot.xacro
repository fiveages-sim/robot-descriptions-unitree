<?xml version="1.0"?>
<robot name="unitree_g1d" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="gazebo" default="false"/>

	<xacro:include filename="$(find unitree_g1d_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find unitree_g1_description)/xacro/ros2_control/arm_ros2_control.xacro"/>
	<xacro:include filename="$(find unitree_dex_description)/xacro/ros2_control/dex1.xacro"/>
	<xacro:include filename="$(find unitree_dex_description)/xacro/ros2_control/dex3.xacro"/>
	<xacro:include filename="$(find brainco_description)/xacro/ros2_control/revo2.xacro"/>

	<!-- Same fallback as UnitreeG1Eefs: empty side arg uses type. -->
	<xacro:property name="g1d_type" value="$(arg type)"/>
	<xacro:property name="g1d_left_arg" value="$(arg left_type)"/>
	<xacro:property name="g1d_right_arg" value="$(arg right_type)"/>
	<xacro:property name="g1d_left_ee" value="${g1d_left_arg if g1d_left_arg != '' else g1d_type}"/>
	<xacro:property name="g1d_right_ee" value="${g1d_right_arg if g1d_right_arg != '' else g1d_type}"/>

	<xacro:macro name="UnitreeG1DEefInterfaces" params="side ee">
		<xacro:if value="${ee == 'dex1'}">
			<xacro:UnitreeDex1Interfaces name="${side}" eef_fixed="$(arg eef_fixed_joints)"/>
		</xacro:if>
		<xacro:if value="${ee == 'dex3'}">
			<xacro:UnitreeDex3Interfaces name="${side}" eef_fixed="$(arg eef_fixed_joints)"/>
		</xacro:if>
		<xacro:if value="${ee == 'revo2'}">
			<xacro:revo2_interfaces name="${side}_hand"/>
		</xacro:if>
	</xacro:macro>

	<ros2_control name="unitree_g1d_system" type="system">
		<hardware>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
				<plugin>gz_ros2_control/GazeboSimSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
				<plugin>mock_components/GenericSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
				<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
				<param name="joint_commands_topic">/isaac/joint_command</param>
				<param name="joint_states_topic">/isaac/joint_states</param>
				<param name="sum_wrapped_joint_states">false</param>
				<param name="initialize_commands_from_state">true</param>
			</xacro:if>
		</hardware>

		<!-- Drive wheels: only when chassis_joints_movable:=true (diff_drive). -->
		<xacro:if value="${'$(arg chassis_joints_movable)' == 'true'}">
			<joint name="Left_Wheel_Joint">
				<command_interface name="velocity">
					<param name="min">-1.0</param>
					<param name="max">1.0</param>
				</command_interface>
				<state_interface name="position"/>
				<state_interface name="velocity"/>
			</joint>
			<joint name="Right_Wheel_Joint">
				<command_interface name="velocity">
					<param name="min">-1.0</param>
					<param name="max">1.0</param>
				</command_interface>
				<state_interface name="position"/>
				<state_interface name="velocity"/>
			</joint>
		</xacro:if>

		<!-- Body: dual-stage lift + pitch stage + torso yaw -->
		<joint name="LZ_mt_Joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="LZ_it_Joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="waist_pitch_joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="waist_yaw_joint">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>

		<!-- Arms (unitree_g1_description). Per-side Dex1 / Dex3 / Revo2. -->
		<xacro:UnitreeG1ArmInterfaces name="left"/>
		<xacro:UnitreeG1ArmInterfaces name="right"/>
		<xacro:UnitreeG1DEefInterfaces side="left" ee="${g1d_left_ee}"/>
		<xacro:UnitreeG1DEefInterfaces side="right" ee="${g1d_right_ee}"/>
	</ros2_control>

	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find unitree_g1d_description)/config/ros2_control/ros2_controllers.yaml</parameters>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
