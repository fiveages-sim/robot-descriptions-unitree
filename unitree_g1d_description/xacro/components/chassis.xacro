<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="UnitreeG1DChassis">
        <link name="AGV_link">
            <inertial>

                <mass value="37"/>
                <inertia ixx="0.091169133" ixy="0.000090756" ixz="0.000185579" iyy="0.081069202" iyz="-0.000057807"
                         izz="0.158050329"/>
            </inertial>
            <visual>

                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/AGV_link.STL"/>
                </geometry>
            </visual>
            <collision>

                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/AGV_link.STL"/>
                </geometry>
            </collision>
        </link>
        <link name="LZ_it_Link">
            <inertial>
                <origin xyz="-0.001566 -0.000192 -0.199159"/>
                <mass value="3.4"/>
                <inertia ixx="0.068209705" ixy="-0.00000153" ixz="0.000139907" iyy="0.068182916" iyz="-0.000006575"
                         izz="0.010584232"/>
            </inertial>
            <visual>

                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/lz_it_link.glb"/>
                </geometry>
            </visual>
        </link>
        <link name="LZ_mt_Link">
            <inertial>
                <origin xyz="0.000494 -0.000062 0.216016"/>
                <mass value="3.3"/>
                <inertia ixx="0.057352663" ixy="0" ixz="0" iyy="0.05735287" iyz="0" izz="0.012847336"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/lz_mt_link.glb"/>
                </geometry>
            </visual>
        </link>
        <link name="LZ_ot_Link">
            <inertial>
                <origin xyz="0.000375 0.000025 -0.000249652"/>
                <mass value="3.3"/>
                <inertia ixx="0.071819941" ixy="-0.000000949" ixz="-0.000008291" iyy="0.071821260" iyz="0.000015866"
                         izz="0.014937474"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/lz_ot_link.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/lz_ot_link.glb"/>
                </geometry>
            </collision>
        </link>
        <link name="Left_Wheel_Link">
            <inertial>
                <origin xyz="-0.000003 -0.000309 -0.000002"/>
                <mass value="1.5"/>
                <inertia ixx="0.001541661" ixy="-0.000000034" ixz="0.00000004" iyy="0.002763727" iyz="-0.000000005"
                         izz="0.001541722"/>
            </inertial>
            <visual>

                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/Left_Wheel_Link.STL"/>
                </geometry>
            </visual>
            <collision>

                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/Left_Wheel_Link.STL"/>
                </geometry>
            </collision>
        </link>
        <link name="Pitching_Link">
            <inertial>
                <origin xyz="0.040544 -0.00377 0.051728"/>
                <mass value="1.889"/>
                <inertia ixx="0.003542953" ixy="0.000140065" ixz="-0.001148746" iyy="0.004845228" iyz="0.000090610"
                         izz="0.003876594"/>
            </inertial>
            <visual>

                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/pitching_link.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/pitching_link.glb"/>
                </geometry>
            </collision>
        </link>
        <link name="RIght_Wheel_Link">
            <inertial>
                <origin xyz="0.000003 0.000309 -0.000002"/>
                <mass value="1.5"/>
                <inertia ixx="0.001541661" ixy="-0.000000034" ixz="-0.000000004" iyy="0.002763727" iyz="0.000000005"
                         izz="0.001541722"/>
            </inertial>
            <visual>

                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/RIght_Wheel_Link.STL"/>
                </geometry>
            </visual>
            <collision>

                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/RIght_Wheel_Link.STL"/>
                </geometry>
