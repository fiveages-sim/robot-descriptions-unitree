        </link>
        <link name="Yaw_Link">
            <inertial>
                <origin xyz="0.000074 -0.000620 0.071221"/>
                <mass value="1.144"/>
                <inertia ixx="0.002602468" ixy="-0.000000583" ixz="-0.000000644" iyy="0.002202746" iyz="-0.000043725"
                         izz="0.001228552"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/yaw_link.glb"/>
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find unitree_g1d_description)/meshes/yaw_link.glb"/>
                </geometry>
