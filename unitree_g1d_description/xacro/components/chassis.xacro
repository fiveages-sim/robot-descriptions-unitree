        </link>
        <joint name="Left_Wheel_Joint" type="continuous">
            <origin xyz="0.000225030065905006 0.2031 -0.0265"/>
            <parent link="AGV_link"/>
            <child link="Left_Wheel_Link"/>
            <axis xyz="0 -1 0"/>
            <limit lower="-3.1416" upper="3.1416" effort="8" velocity="100"/>
        </joint>
        <joint name="Right_Wheel_Joint" type="continuous">
            <origin xyz="0.000225030065905024 -0.2031 -0.0265"/>
            <parent link="AGV_link"/>
            <child link="RIght_Wheel_Link"/>
            <axis xyz="0 1 0"/>
            <limit lower="-3.1416" upper="3.1416" effort="8" velocity="100"/>
        </joint>
        <joint name="LZ_ot_Joint" type="fixed">
            <origin xyz="-0.000162639876214998 0 0.5275"/>
            <parent link="AGV_link"/>
            <child link="LZ_ot_Link"/>
        </joint>
        <joint name="LZ_mt_Joint" type="prismatic">
            <origin xyz="0.000387669942120007 0 0.00999999999999995"/>
            <parent link="LZ_ot_Link"/>
            <child link="LZ_mt_Link"/>
            <axis xyz="0 0 1"/>
            <limit lower="0" upper="0.21" effort="500" velocity="0.05"/>
        </joint>
        <joint name="LZ_it_Joint" type="prismatic">
            <origin xyz="0.0013627 0.00020167 0.018"/>
            <parent link="LZ_mt_Link"/>
            <child link="LZ_it_Link"/>
            <axis xyz="0 0 1"/>
            <limit lower="0" upper="0.21" effort="500" velocity="0.05"/>
        </joint>
        <joint name="Pitching_Joint" type="fixed">
            <origin xyz="-0.0013627 -0.00020167 0.008"/>
            <parent link="LZ_it_Link"/>
            <child link="Pitching_Link"/>
        </joint>
        <joint name="Yaw_Joint" type="revolute">
            <origin xyz="0.0555 0.0002165 0.066"/>
            <parent link="Pitching_Link"/>
            <child link="Yaw_Link"/>
            <axis xyz="0 1 0"/>
            <limit lower="-0.04363" upper="2.3562" effort="80" velocity="5"/>
        </joint>
    </xacro:macro>
</robot>
