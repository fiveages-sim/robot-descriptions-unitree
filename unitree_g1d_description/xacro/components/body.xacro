<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:include filename="$(find unitree_g1_description)/xacro/torso.xacro"/>

	<!--
	Mount G1 torso onto the G1-D yaw stage.
	Official torso_Joint origin was z=0.104008566 for the G1-D torso frame;
	G1 torso_link is 9.8 mm lower relative to the visual mesh, so subtract that.
	-->
	<xacro:macro name="UnitreeG1DBody">
		<xacro:UnitreeG1Torso/>

		<joint name="torso_yaw_joint" type="revolute">
			<origin xyz="-0.0023536 -0.000048782 ${0.104008566 - 0.0098}" rpy="0 0 0"/>
			<parent link="Yaw_Link"/>
			<child link="torso_link"/>
			<axis xyz="0 0 1"/>
			<limit lower="-2.7053" upper="2.7053" effort="30" velocity="5"/>
		</joint>
	</xacro:macro>

</robot>
