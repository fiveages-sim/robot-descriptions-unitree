<?xml version="1.0" ?>
<!-- Deprecated: use eefs.xacro / UnitreeG1Eefs. Kept so older includes keep working. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="type" default="rubber_hand"/>
	<xacro:arg name="eef_fixed_joints" default="false"/>
	<xacro:include filename="$(find unitree_g1_description)/xacro/eefs.xacro"/>
	<xacro:UnitreeG1Eefs type="$(arg type)" eef_fixed="$(arg eef_fixed_joints)"/>
</robot>
