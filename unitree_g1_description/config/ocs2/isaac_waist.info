; robot model meta-information
model_information {
  manipulatorModelType     0      // 0: Default-arm, 1: Wheel-based manipulator, 2: Floating-arm manipulator, 3: Fully actuated floating-arm manipulator
  
  ; motion joints in the URDF to consider fixed
  removeJoints {
    ; Leg joints - Left leg
    [0] "left_hip_pitch_joint"
    [1] "left_hip_roll_joint"
    [2] "left_hip_yaw_joint"
    [3] "left_knee_joint"
    [4] "left_ankle_pitch_joint"
    [5] "left_ankle_roll_joint"

    ; Leg joints - Right leg
    [6] "right_hip_pitch_joint"
    [7] "right_hip_roll_joint"
    [8] "right_hip_yaw_joint"
    [9] "right_knee_joint"
    [10] "right_ankle_pitch_joint"
    [11] "right_ankle_roll_joint"

    ; Plan waist yaw/roll and both arms; keep waist pitch fixed at zero.
    ; Remaining DOFs: waist (0-1), left arm (2-8), right arm (9-15).
    ; Order must match `joints` in ros2_control/isaac.yaml.
    [12] "waist_pitch_joint"
  }

  ; base frame of the robot (from URDF)
  baseFrame                       "base_link"
  ; end-effector frame of the robot (from URDF)
  eeFrame                         "left_tcp"
  eeFrame1                        "right_tcp"
}

model_settings
{
  usePreComputation               true
  recompileLibraries              true
}

; DDP settings
ddp
{
  algorithm                       SLQ

  nThreads                        3
  threadPriority                  50

  maxNumIterations                1
  minRelCost                      0.1
  constraintTolerance             1e-3

  displayInfo                     false
  displayShortSummary             false
  checkNumericalStability         false
  debugPrintRollout               false
  debugCaching                    false

  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  maxNumStepsPerSecond            100000
  timeStep                        1e-3
  backwardPassIntegratorType      ODE45

  constraintPenaltyInitialValue   20.0
  constraintPenaltyIncreaseRate   2.0

  preComputeRiccatiTerms          true

  useFeedbackPolicy               false

  strategy                        LINE_SEARCH
  lineSearch
  {
    minStepLength                 1e-2
    maxStepLength                 1.0
    hessianCorrectionStrategy     DIAGONAL_SHIFT
    hessianCorrectionMultiple     1e-3
  }
}

; Rollout settings
rollout
{
  AbsTolODE                       1e-5
  RelTolODE                       1e-3
  timeStep                        1e-2
  integratorType                  ODE45
  maxNumStepsPerSecond            100000
  checkNumericalStability         false
}

; MPC settings
mpc
{
  timeHorizon                     1.0   ; [s]
  solutionTimeWindow              0.2   ; [s]
  coldStart                       false
  
  debugPrint                      false

  mpcDesiredFrequency             100   ; [Hz]
  mrtDesiredFrequency             400   ; [Hz]
}

; initial state
initialState
{
  ; initial state for the different types of arm base DOFs
  base
  {
    wheelBasedMobileManipulator
    {
      (0,0)  0.0  ; position x
      (1,0)  0.0  ; position y
      (2,0)  0.0  ; heading
    }
  }

  ; initial state for the arm DOFs
  arm
  {
    ; Waist joints (2 joints)
    (0,0)   0.0      ; waist_yaw_joint
    (1,0)   0.0      ; waist_roll_joint
    
    ; Left arm joints (7 joints)
    (2,0)   0.0      ; left_shoulder_pitch_joint
    (3,0)   0.0      ; left_shoulder_roll_joint
    (4,0)   0.0      ; left_shoulder_yaw_joint
    (5,0)   0.0      ; left_elbow_joint
    (6,0)   0.0      ; left_wrist_roll_joint
    (7,0)   0.0      ; left_wrist_pitch_joint
    (8,0)   0.0      ; left_wrist_yaw_joint
    
    ; Right arm joints (7 joints)
    (9,0)  0.0      ; right_shoulder_pitch_joint
    (10,0)  0.0      ; right_shoulder_roll_joint
    (11,0)  0.0      ; right_shoulder_yaw_joint
    (12,0)  0.0      ; right_elbow_joint
    (13,0)  0.0      ; right_wrist_roll_joint
    (14,0)  0.0      ; right_wrist_pitch_joint
    (15,0)  0.0      ; right_wrist_yaw_joint
  }
}

inputCost
{
  ; control weight matrix
  R
  {
    ; input costs for the different types of arm base DOFs
    base
    {
      defaultManipulator
      {
      }

      floatingArmManipulator
      {
      }

      fullyActuatedFloatingArmManipulator
      {
        scaling 1e-2
        (0,0)  5.0  ; position x
        (1,1)  5.0  ; position y
        (2,2)  5.0  ; position z
        (3,3)  5.0  ; euler angle z
        (4,4)  5.0  ; euler angle y
        (5,5)  5.0  ; euler angle x
      }

      wheelBasedMobileManipulator
      {
        scaling 1e-2
        (0,0)  1.5  ; forward velocity
        (1,1)  1.5  ; turning velocity
      }
    }
    
    ; input costs for the arm DOFs
    arm
    {
      scaling 1e-3

      ; Waist joints (2 joints)
      (0,0)   0.06      ; waist_yaw_joint
      (1,1)   0.06      ; waist_roll_joint
      
      ; Left arm joints (7 joints)
      (2,2)   0.06      ; left_shoulder_pitch_joint
      (3,3)   0.06      ; left_shoulder_roll_joint
      (4,4)   0.06      ; left_shoulder_yaw_joint
      (5,5)   0.06      ; left_elbow_joint
      (6,6)   0.06      ; left_wrist_roll_joint
      (7,7)   0.06      ; left_wrist_pitch_joint
      (8,8)   0.06      ; left_wrist_yaw_joint
      
      ; Right arm joints (7 joints)
      (9,9) 0.06      ; right_shoulder_pitch_joint
      (10,10) 0.06      ; right_shoulder_roll_joint
      (11,11) 0.06      ; right_shoulder_yaw_joint
      (12,12) 0.06      ; right_elbow_joint
      (13,13) 0.06      ; right_wrist_roll_joint
      (14,14) 0.06      ; right_wrist_pitch_joint
      (15,15) 0.06      ; right_wrist_yaw_joint
    }
  }
}

endEffector
{
  ; end effector quadratic penalty scaling
  dualArmMode      true
  leftArm
    {
      muPosition      10.0
      muOrientation    5.0
    }

    ; 右臂特定配置
  rightArm
    {
      muPosition      10.0
      muOrientation    5.0
    }
}

finalEndEffector
{
  dualArmMode      true
  leftArm
    {
      muPosition      10.0
      muOrientation    5.0
    }

    ; 右臂特定配置
  rightArm
    {
      muPosition      10.0
      muOrientation    5.0
    }
}

selfCollision
{ 
  ; activate self-collision constraint
  activate  true

  ; Self Collision raw object pairs (indices of the Pinocchio collision model).
  ; Kept empty on purpose: those indices shift whenever the URDF changes, while
  ; link names below are stable. Use collisionLinkPairs instead.
  collisionObjectPairs
  {
  }

  ; Self Collision pairs by link name. Each pair expands to every collision-object
  ; pair between the two links (all-vs-all, hence a superset of a single
  ; object-index pair).
  collisionLinkPairs
  {
      ; Symmetric by construction: upper arm (shoulder_yaw) + elbow on both sides.
      ; Reference: collision-object indices of the current URDF (document order)
      ;   torso_link = 18/19, left_shoulder_yaw_link = 23/24, left_elbow_link = 25,
      ;   right_shoulder_yaw_link = 30/31, right_elbow_link = 32
      [0] "torso_link, left_shoulder_yaw_link"
      [1] "torso_link, left_elbow_link"
      [2] "torso_link, right_shoulder_yaw_link"
      [3] "torso_link, right_elbow_link"
  }

  ; minimum distance allowed between the pairs
  minimumDistance  0.01

  ; relaxed log barrier mu
  mu      1e-3

  ; relaxed log barrier delta
  delta   1e-4
}

; Only applied for arm joints: limits parsed from URDF
jointPositionLimits
{
  ; activate constraint
  activate  true

  ; relaxed log barrier mu
  mu      0.1

  ; relaxed log barrier delta
  delta   1e-2
}

jointVelocityLimits
{
  ; relaxed log barrier mu
  mu      0.01

  ; relaxed log barrier delta
  delta   1e-3

  lowerBound
  {
    ; velocity limits for the different types of arm base DOFs
    base
    {
      defaultManipulator
      {
      }

      floatingArmManipulator
      {
      }

      fullyActuatedFloatingArmManipulator
      {
        (0,0)  -0.1  ; linear velocity x
        (1,0)  -0.1  ; linear velocity y
        (2,0)  -0.1  ; linear velocity z
        (3,0)  -0.3  ; euler angle velocity z
        (4,0)  -0.3  ; euler angle velocity y
        (5,0)  -0.3  ; euler angle velocity x
      }

      wheelBasedMobileManipulator
      {
        (0,0)  -2.0 ; forward velocity
        (1,0)  -2.0 ; turning velocity
      }
    }

    ; velocity limits for the arm DOFs
    arm
    {
      ; Waist joints (2 joints)
      (0,0)  -0.9         ; waist_yaw_joint [rad/s]
      (1,0)  -0.9         ; waist_roll_joint [rad/s]
      
      ; Left arm joints (7 joints)
      (2,0)  -1.57        ; left_shoulder_pitch_joint [rad/s]
      (3,0)  -1.57        ; left_shoulder_roll_joint [rad/s]
      (4,0)  -1.57        ; left_shoulder_yaw_joint [rad/s]
      (5,0)  -1.57        ; left_elbow_joint [rad/s]
      (6,0)  -1.57        ; left_wrist_roll_joint [rad/s]
      (7,0)  -1.57        ; left_wrist_pitch_joint [rad/s]
      (8,0)  -1.57        ; left_wrist_yaw_joint [rad/s]
      
      ; Right arm joints (7 joints)
      (9,0) -1.57        ; right_shoulder_pitch_joint [rad/s]
      (10,0) -1.57        ; right_shoulder_roll_joint [rad/s]
      (11,0) -1.57        ; right_shoulder_yaw_joint [rad/s]
      (12,0) -1.57        ; right_elbow_joint [rad/s]
      (13,0) -1.57        ; right_wrist_roll_joint [rad/s]
      (14,0) -1.57        ; right_wrist_pitch_joint [rad/s]
      (15,0) -1.57        ; right_wrist_yaw_joint [rad/s]
    }
  }

  upperBound
  {
    ; velocity limits for the different types of arm base DOFs
    base
    {
      defaultManipulator
      {
      }

      floatingArmManipulator
      {
      }

      fullyActuatedFloatingArmManipulator
      {
        (0,0)  0.1  ; linear velocity x
        (1,0)  0.1  ; linear velocity y
        (2,0)  0.1  ; linear velocity z
        (3,0)  0.3  ; euler angle velocity z
        (4,0)  0.3  ; euler angle velocity y
        (5,0)  0.3  ; euler angle velocity x
      }

      wheelBasedMobileManipulator
      {
        (0,0)  2.0 ; forward velocity
        (1,0)  2.0 ; turning velocity
      }
    }

    ; velocity limits for the arm DOFs
    arm
    {
      ; Waist joints (2 joints)
      (0,0)  0.9          ; waist_yaw_joint [rad/s]
      (1,0)  0.9          ; waist_roll_joint [rad/s]
      
      ; Left arm joints (7 joints)
      (2,0)  1.57         ; left_shoulder_pitch_joint [rad/s]
      (3,0)  1.57         ; left_shoulder_roll_joint [rad/s]
      (4,0)  1.57         ; left_shoulder_yaw_joint [rad/s]
      (5,0)  1.57         ; left_elbow_joint [rad/s]
      (6,0)  1.57         ; left_wrist_roll_joint [rad/s]
