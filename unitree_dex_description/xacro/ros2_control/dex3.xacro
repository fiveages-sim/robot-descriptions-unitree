<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!--
	Dex3 ros2_control interfaces. name="left" yields left_hand_*_joint.
	eef_fixed:=true matches the planning URDF, which freezes the fingers.
	-->
	<xacro:macro name="UnitreeDex3Joint" params="jname">
		<joint name="${jname}">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
	</xacro:macro>

	<xacro:macro name="UnitreeDex3Interfaces" params="name eef_fixed:=false">
		<xacro:property name="prefix" value="${name}_"/>
		<xacro:property name="eef_is_fixed" value="${str(eef_fixed).lower() in ['1', 'true', 'yes', 'on']}"/>

		<xacro:unless value="${eef_is_fixed}">
			<xacro:UnitreeDex3Joint jname="${prefix}hand_thumb_0_joint"/>
			<xacro:UnitreeDex3Joint jname="${prefix}hand_thumb_1_joint"/>
			<xacro:UnitreeDex3Joint jname="${prefix}hand_thumb_2_joint"/>
			<xacro:UnitreeDex3Joint jname="${prefix}hand_middle_0_joint"/>
			<xacro:UnitreeDex3Joint jname="${prefix}hand_middle_1_joint"/>
			<xacro:UnitreeDex3Joint jname="${prefix}hand_index_0_joint"/>
			<xacro:UnitreeDex3Joint jname="${prefix}hand_index_1_joint"/>
		</xacro:unless>
	</xacro:macro>
</robot>
